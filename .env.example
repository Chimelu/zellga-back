PORT=4001
NODE_ENV=development

# PostgreSQL (Neon or any Postgres URL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=zellga/products

# Public web app — used to build invite and affiliate share links in email.
APP_URL=http://localhost:3000

# Paystack. Leave the secret unset and card checkout returns a clear
# "not configured" error while WhatsApp checkout keeps working.
# Webhook URL to register in the Paystack dashboard:
#   https://your-api-host/api/payments/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# Where Paystack returns the buyer after checkout. Defaults to
# $APP_URL/checkout/callback when unset.
PAYSTACK_CALLBACK_URL=

# Outgoing mail (affiliate invites). Leave SMTP_HOST unset in development and
# the message is printed to the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Zellga <no-reply@zellga.com>"
